{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "GIT_DIR",
    "GIT_WORK_TREE",
    "NEXT_TELEMETRY_DISABLED",
    "EXPO_NO_TELEMETRY",
    "EXPO_PUBLIC_APP_MODE"
  ],
  "tasks": {
    "typecheck": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "typecheck"
      ],
      "cache": false
    },
    "//#typecheck": {
      "cache": false
    },
    "//#build": {
      "cache": false
    },
    "//#test": {
      "cache": false
    }
  }
}
