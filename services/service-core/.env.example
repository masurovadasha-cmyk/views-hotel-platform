# Isolated development environment only. Never commit secrets.
DATABASE_URL=postgresql://views_app:change-me@127.0.0.1:5432/views_dev
VIEWS_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3200
# Explicitly enable development-only tokens for isolated local testing.
# Never set this on a publicly reachable production deployment.
VIEWS_AUTH_MODE=dev
VIEWS_ALLOW_DEV_AUTH=1

# OIDC alternative for a separately hardened service (not the dev Docker stack):
# VIEWS_AUTH_MODE=oidc
# VIEWS_ALLOW_DEV_AUTH=0
# VIEWS_OIDC_ISSUER=https://your-identity-provider.example/
# VIEWS_OIDC_AUDIENCE=views-service-api
# VIEWS_OIDC_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
# The provider must issue signed access tokens with organization_id UUID
# and views_roles array claims. Never accept these values from request bodies.
