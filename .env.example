VIEWS_ENV=staging
VIEWS_PAYMENT_PROVIDER_ENABLED=false
VIEWS_ALLOW_DEMO_HEADERS=false
VIEWS_EXPOSE_LOGIN_TOKEN=false
VIEWS_ALLOWED_ORIGINS=https://staging.views-hotel-platform.pages.dev

# Pages/BFF -> Core endpoint.
VIEWS_CORE_API_URL=https://core-staging.example.invalid

# Stage 7.7 preferred Pages/BFF credential.
# Store VIEWS_CORE_SIGNING_PRIVATE_KEY as a deployment secret, never in source control.
VIEWS_CORE_SIGNING_KID=pages-bff-2026-10
VIEWS_CORE_SIGNING_PRIVATE_KEY=<ed25519-pkcs8-private-key-pem-secret>

# Migration fallback only. When the signing pair is configured, Pages sends a
# signed service token and does not send this legacy symmetric key.
VIEWS_CORE_API_KEY=<pages-bff-current-key-min-32-chars>

# Core production: non-secret mapping from service IDs to symmetric secret env references.
# Stage 7.7 keeps this ring during the migration window; a later stage can remove it
# after all trusted senders use signed tokens.
VIEWS_INTERNAL_SERVICE_KEY_REFS_JSON={"pages-bff":["VIEWS_INTERNAL_PAGES_BFF_KEY_CURRENT"],"analytics-cron":["VIEWS_INTERNAL_ANALYTICS_CRON_KEY_CURRENT"]}
VIEWS_INTERNAL_PAGES_BFF_KEY_CURRENT=<pages-bff-current-key-min-32-chars>
VIEWS_INTERNAL_ANALYTICS_CRON_KEY_CURRENT=<analytics-cron-current-key-min-32-chars>

# Core Stage 7.7: service signing public keys by kid/reference.
# Public keys are not secrets, but references keep rotation/configuration explicit.
VIEWS_INTERNAL_SERVICE_PUBLIC_KEY_REFS_JSON={"pages-bff":[{"kid":"pages-bff-2026-10","ref":"VIEWS_INTERNAL_PAGES_BFF_PUBLIC_KEY"}]}
VIEWS_INTERNAL_PAGES_BFF_PUBLIC_KEY=<ed25519-spki-public-key-pem>

# Rotation example for a symmetric fallback: add a previous secret only while old-key traffic drains.
# VIEWS_INTERNAL_PAGES_BFF_KEY_PREVIOUS=<pages-bff-previous-key-min-32-chars>
# Then set pages-bff refs to:
# ["VIEWS_INTERNAL_PAGES_BFF_KEY_CURRENT","VIEWS_INTERNAL_PAGES_BFF_KEY_PREVIOUS"]

# Signed-key rotation uses two public-key entries with distinct kid values for the
# same service while senders move to the new private key.

# Non-production migration fallback only. Production requires
# VIEWS_INTERNAL_SERVICE_KEY_REFS_JSON and does not accept raw service-key JSON
# as a replacement.
# VIEWS_INTERNAL_SERVICE_KEYS_JSON={"pages-bff":["<dev-key-min-32-chars>"]}

# Legacy Core-wide ring retained for development/test/backward migration only.
VIEWS_INTERNAL_API_KEY=<legacy-current-key-min-32-chars>
VIEWS_INTERNAL_API_KEY_PREVIOUS=<legacy-previous-key-min-32-chars>
