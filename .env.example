VIEWS_ENV=staging
VIEWS_PAYMENT_PROVIDER_ENABLED=false
VIEWS_ALLOW_DEMO_HEADERS=false
VIEWS_EXPOSE_LOGIN_TOKEN=false
VIEWS_ALLOWED_ORIGINS=https://staging.views-hotel-platform.pages.dev

# Pages/BFF sender-side secret for pages-bff.
# Must equal one accepted pages-bff key in Core VIEWS_INTERNAL_SERVICE_KEYS_JSON.
VIEWS_CORE_API_URL=https://core-staging.example.invalid
VIEWS_CORE_API_KEY=<pages-bff-current-key-min-32-chars>

# Core production: service-specific trusted key rings.
# Each service gets 1 current key or [current, previous] during rotation.
# One raw key MUST NOT appear under two different service IDs.
VIEWS_INTERNAL_SERVICE_KEYS_JSON={"pages-bff":["<pages-bff-current-key-min-32-chars>"],"analytics-cron":["<analytics-cron-current-key-min-32-chars>"]}

# Legacy Core-wide ring retained for development/test/backward migration only.
# When VIEWS_INTERNAL_SERVICE_KEYS_JSON is non-empty, trusted-service verification
# uses the service-specific ring and does not fall back to these values.
VIEWS_INTERNAL_API_KEY=<legacy-current-key-min-32-chars>
VIEWS_INTERNAL_API_KEY_PREVIOUS=<legacy-previous-key-min-32-chars>
