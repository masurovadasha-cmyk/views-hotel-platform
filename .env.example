VIEWS_ENV=staging
VIEWS_PAYMENT_PROVIDER_ENABLED=false
VIEWS_ALLOW_DEMO_HEADERS=false
VIEWS_EXPOSE_LOGIN_TOKEN=false
VIEWS_ALLOWED_ORIGINS=https://staging.views-hotel-platform.pages.dev

# Pages/BFF -> Core endpoint.
VIEWS_CORE_API_URL=https://core-staging.example.invalid

# Stage 7.7 preferred Pages/BFF credential.
# Store VIEWS_CORE_SIGNING_PRIVATE_KEY as a deployment secret, never in source control.
VIEWS_CORE_SIGNING_KID=pages-bff-2026-10
VIEWS_CORE_SIGNING_PRIVATE_KEY=<ed25519-pkcs8-private-key-pem-secret>

# Migration fallback only. When the signing pair is configured, Pages sends a
# signed service token and does not send this legacy symmetric key.
VIEWS_CORE_API_KEY=<pages-bff-current-key-min-32-chars>

# Stage 7.10: explicit production authentication mode per trusted service.
# Roll out per service: internal_key_only -> dual -> signed_only.
# In signed_only mode the service does not require a symmetric secret.
VIEWS_INTERNAL_SERVICE_AUTH_MODES_JSON={"pages-bff":"signed_only","analytics-cron":"signed_only"}

# Stage 7.12-7.15 Core ingress boundary.
# cloudflare: public HTTPS origin behind Cloudflare; configure current provider CIDRs.
# cloudflare_tunnel: Core has no public listener and only pinned cloudflared
# replicas may reach it. Use exact connector host CIDRs (/32 or /128), never
# Cloudflare's public edge ranges. The Stage 7.15 HA baseline pins two replicas.
# Forwarded CF-Connecting-IP is trusted only after the immediate peer passes
# this boundary.
TRUSTED_PROXY_MODE=cloudflare_tunnel
VIEWS_TRUSTED_PROXY_CIDRS_JSON=["172.30.0.2/32","172.30.0.4/32"]

# Optional additional service egress restriction after trusted-proxy validation.
# Use only when the sender has stable egress CIDRs. In direct mode this map is
# required for every production trusted service.
# VIEWS_INTERNAL_SERVICE_SOURCE_CIDRS_JSON={"pages-bff":["<pages-egress-cidr>"],"analytics-cron":["<cron-egress-cidr>"]}

# Core production: non-secret mapping from service IDs to symmetric secret env references.
# Required only for services whose Stage 7.10 mode is internal_key_only or dual.
# A signed_only service may omit its symmetric reference and secret entirely.
# Uncomment only for services whose auth mode is internal_key_only or dual:
# VIEWS_INTERNAL_SERVICE_KEY_REFS_JSON={"pages-bff":["VIEWS_INTERNAL_PAGES_BFF_KEY_CURRENT"],"analytics-cron":["VIEWS_INTERNAL_ANALYTICS_CRON_KEY_CURRENT"]}
# VIEWS_INTERNAL_PAGES_BFF_KEY_CURRENT=<pages-bff-current-key-min-32-chars>
# VIEWS_INTERNAL_ANALYTICS_CRON_KEY_CURRENT=<analytics-cron-current-key-min-32-chars>

# Stage 7.8 analytics-cron sender. Keep the private key in the scheduler/runner
# deployment secret manager. The runner always uses a signed token and never a
# symmetric Core key.
VIEWS_ANALYTICS_CRON_SIGNING_KID=analytics-cron-2026-10
VIEWS_ANALYTICS_CRON_SIGNING_PRIVATE_KEY=<ed25519-pkcs8-private-key-pem-secret>
# Optional bounded cycle limits:
# VIEWS_ANALYTICS_CRON_SCHEDULE_LIMIT=20
# VIEWS_ANALYTICS_CRON_REPORT_LIMIT=20
# VIEWS_ANALYTICS_CRON_PRUNE_LIMIT=1000

# Core Stage 7.7: service signing public keys by kid/reference.
# Public keys are not secrets, but references keep rotation/configuration explicit.
# Stage 7.9 requires activatedAt + rotateBy for every production signing key so
# rotation posture is based on deployment metadata rather than log first-seen time.
VIEWS_INTERNAL_SERVICE_PUBLIC_KEY_REFS_JSON={"pages-bff":[{"kid":"pages-bff-2026-10","ref":"VIEWS_INTERNAL_PAGES_BFF_PUBLIC_KEY","activatedAt":"2026-10-06T00:00:00Z","rotateBy":"2027-01-04T00:00:00Z"}],"analytics-cron":[{"kid":"analytics-cron-2026-10","ref":"VIEWS_INTERNAL_ANALYTICS_CRON_PUBLIC_KEY","activatedAt":"2026-10-06T00:00:00Z","rotateBy":"2027-01-04T00:00:00Z"}]}
VIEWS_INTERNAL_PAGES_BFF_PUBLIC_KEY=<ed25519-spki-public-key-pem>
VIEWS_INTERNAL_ANALYTICS_CRON_PUBLIC_KEY=<ed25519-spki-public-key-pem>

# Rotation example for a symmetric fallback: add a previous secret only while old-key traffic drains.
# VIEWS_INTERNAL_PAGES_BFF_KEY_PREVIOUS=<pages-bff-previous-key-min-32-chars>
# Then set pages-bff refs to:
# ["VIEWS_INTERNAL_PAGES_BFF_KEY_CURRENT","VIEWS_INTERNAL_PAGES_BFF_KEY_PREVIOUS"]

# Signed-key rotation uses two public-key entries with distinct kid values for the
# same service while senders move to the new private key.

# Non-production migration fallback only. Production requires
# VIEWS_INTERNAL_SERVICE_KEY_REFS_JSON and does not accept raw service-key JSON
# as a replacement.
# VIEWS_INTERNAL_SERVICE_KEYS_JSON={"pages-bff":["<dev-key-min-32-chars>"]}

# Legacy Core-wide ring retained for development/test/backward migration only.
VIEWS_INTERNAL_API_KEY=<legacy-current-key-min-32-chars>
VIEWS_INTERNAL_API_KEY_PREVIOUS=<legacy-previous-key-min-32-chars>


# Stage 7.20 Payme Merchant API sandbox only.
# Production activation is deliberately rejected by the current code.
VIEWS_PAYME_SANDBOX_ENABLED=false
VIEWS_PAYME_MODE=sandbox
VIEWS_PAYME_ORGANIZATION_ID=
VIEWS_PAYME_MERCHANT_ID=
VIEWS_PAYME_MERCHANT_LOGIN=
VIEWS_PAYME_TEST_KEY=
# Test/development only. Ignored in NODE_ENV=production, where the official
# Payme Business source IP allowlist is hard-coded.
VIEWS_PAYME_TEST_SOURCE_CIDRS_JSON=
